{
  "name": "islet",
  "version": "2.3.4",
  "description": "Islet: a Dynamic-Island style notch for Windows: Spotify now playing + latest Claude Code activity",
  "main": "src/main.js",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.gopin.islet",
    "productName": "Islet",
    "asar": false,
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "src/**",
      "builtin-pets/**",
      "settings/**",
      "hooks/**",
      "renderer/**",
      "assets/logo-apple/icon.ico",
      "LICENSE"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "goprocker",
        "repo": "Islet"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Islet-Setup-${version}.${ext}",
      "icon": "assets/logo-apple/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "include": "build/installer.nsh",
      "runAfterFinish": true
    },
    "appx": {
      "applicationId": "Islet",
      "displayName": "Islet",
      "publisherDisplayName": "Gopin",
      "identityName": "Gopin.Islet",
      "publisher": "CN=Gopin",
      "artifactName": "Islet-${version}.${ext}",
      "backgroundColor": "transparent",
      "languages": [
        "en-US"
      ],
      "showNameOnTiles": false
    }
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "^26.18.0"
  },
  "overrides": {
    "minimatch": "11.0.3"
  },
  "allowScripts": {
    "electron@45.2.3": true
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "qrcode": "^1.5.4"
  }
}
