{
  "name": "islet",
  "version": "2.0.0",
  "description": "Islet: a Dynamic-Island style notch for Windows: Spotify now playing + latest Claude Code activity",
  "main": "main.js",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.gopin.islet",
    "productName": "Islet",
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "spotify-web.js",
      "notifications.js",
      "calendar.js",
    "icons.js",
    "lyrics.js",
    "weather.js",
    "downloads.js",
    "shelf-file.js",
    "helper-lifecycle.js",
    "audio-target.js",
    "config-check.js",
    "settings/**",
    "claude-bridge.js",
    "hooks/**",
      "helpers.ps1",
      "media.ps1",
    "system.ps1",
      "spotify-audio.ps1",
      "spotify-audio.cs",
      "renderer/**",
      "assets/logo-apple/icon.ico",
      "LICENSE"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/logo-apple/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true
    }
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "^26.18.0"
  },
  "overrides": {
    "minimatch": "11.0.3"
  },
  "allowScripts": {
    "electron@45.2.1": true
  }
}
