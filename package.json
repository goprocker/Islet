{
  "name": "islet",
  "version": "2.3.4",
  "description": "Islet: a Dynamic-Island style notch for Windows: Spotify now playing + latest Claude Code activity",
  "main": "main.js",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.gopin.islet",
    "productName": "Islet",
    "asar": false,
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "main.js",
      "preload.js",
      "spotify-web.js",
      "notifications.js",
      "calendar.js",
      "icons.js",
      "lyrics.js",
      "weather.js",
      "downloads.js",
      "screenshots.js",
      "devices.js",
      "shelf-file.js",
      "helper-lifecycle.js",
      "audio-target.js",
      "welcome.js",
      "config-check.js",
      "clip-history.js",
      "notes.js",
      "pomodoro.js",
      "quick-settings.js",
      "search.js",
      "volume-hud.js",
      "links.js",
      "pet-pack.js",
      "builtin-pets/**",
      "phone-drop.js",
      "missed.js",
      "quickset.ps1",
      "radios.ps1",
      "volume-hud.ps1",
      "settings/**",
      "claude-bridge.js",
      "hooks/**",
      "helpers.ps1",
      "media.ps1",
      "system.ps1",
      "devices.ps1",
      "spotify-audio.ps1",
      "spotify-audio.cs",
      "renderer/**",
      "assets/logo-apple/icon.ico",
      "LICENSE"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "goprocker",
        "repo": "Islet"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Islet-Setup-${version}.${ext}",
      "icon": "assets/logo-apple/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "include": "build/installer.nsh",
      "runAfterFinish": true
    }
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "^26.18.0"
  },
  "overrides": {
    "minimatch": "11.0.3"
  },
  "allowScripts": {
    "electron@45.2.3": true
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "qrcode": "^1.5.4"
  }
}
